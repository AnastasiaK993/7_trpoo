<Page x:Class="Cars_Client_seven.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cars_Client_seven.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel   Grid.Row="0" Grid.ColumnSpan="2"
           Orientation="Horizontal"  Margin="10"  >

            <Button  Content="Создать" Click="ClickPost"/>
            <Button Content="Изменить" Click="ClickEdit"/>
            <Button Content="Удалить" Click="ClickDelete"/>   
            <Button Content="обновить"  Click="ClickNormal"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="10">
            <TextBlock Text="Фильтр по Brand"/>
            <TextBox Text="{Binding FilterBrand, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Макс. цена"/>
            <TextBox Text="{Binding FilterMaxPrice, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="фильтр" Click="ClickFilter" />
        </StackPanel>

        <ListView Grid.Row="1" Grid.Column="1" Margin="10"    ScrollViewer.VerticalScrollBarVisibility="Auto"
ItemsSource="{Binding Cars}"
MouseDoubleClick="Show"
SelectedItem="{Binding SelectedCar}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border 
          BorderBrush="Aqua"
            BorderThickness="2">
                            <StackPanel >
                                <TextBlock  Text="{Binding Brand}"/>
                            <TextBlock Text="{Binding Model}"/>
                                <TextBlock Text="{Binding Price}"/>
                                <TextBlock Text="{Binding ReleaseYear, StringFormat=
{}{0:dd.MM.yyyy}}"/>
                            <TextBlock Text="{Binding IsAvailable}"/>
                         
                          

                        </StackPanel>
                    </Border>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
