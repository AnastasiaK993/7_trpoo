<Page x:Class="Cars_Client_seven.Pages.PostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cars_Client_seven.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PostPage">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">


            <StackPanel Margin="20">
                <TextBlock Text="Brand"/>
                <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Model" />
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="ReleaseYear" />
                <TextBox Text="{Binding ReleaseYear, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Price" />
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>

                <CheckBox Content="IsAvailable" IsChecked="{Binding IsAvailable}" />

                <StackPanel Orientation="Horizontal" >
                    <Button Content="Сохранить" Click="ClickSave" Margin="8"/>
                    <Button Content="Выйти" Click="ClickOut"/>
                </StackPanel>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>
